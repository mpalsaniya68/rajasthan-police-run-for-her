# ==============================================================================
# 🏛️ राजस्थान पुलिस मैराथन 2027 (RUN FOR HER) - पर्यावरण चर विन्यास (ENVIRONMENT CONFIGURATION)
# ==============================================================================
# यह फ़ाइल संपूर्ण प्रोजेक्ट की केंद्रीय कॉन्फ़िगरेशन मार्गदर्शिका है।
# इस फ़ाइल की एक प्रतिलिपि बनाकर उसका नाम '.env' रखें।
# 
# ⚠️ सुरक्षा चेतावनी (SECURITY NOTICE):
# '.env' फ़ाइल में संवेदनशील क्रेडेंशियल्स (डेटाबेस टोकन, पासवर्ड, सीक्रेट कीज़) होते हैं।
# इसे कभी भी गिट (GitHub/GitLab) पर कमिट न करें। यह फ़ाइल .gitignore में सुरक्षित है।
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 🗄️ डेटाबेस विन्यास (DATABASE ENGINE & PORTABILITY CONFIGURATION)
# ------------------------------------------------------------------------------
# 📌 यह की क्यों है और क्या करती है?
# यह तय करती है कि सारा डेटा (धावकों का पंजीकरण, बिब नंबर, किट वितरण स्थिति, RFID टाइमिंग 
# और प्रशासनिक खाते) कहाँ स्टोर होंगे। सिस्टम 100% पोर्टेबल है।
#
# 🔄 डेटाबेस कैसे बदलें (TURSO से हटाकर कहीं और ले जाने की प्रक्रिया):
# कोड में बिना किसी बदलाव के सिर्फ नीचे 'DATABASE_URL' और 'DATABASE_AUTH_TOKEN' बदलने से
# पूरा प्रोजेक्ट तुरंत नए डेटाबेस पर शिफ्ट हो जाएगा और सभी टेबल्स व इंडेक्स स्वतः बन जाएंगे!
#
#   विकल्प A: नया Turso Cloud Edge DB पर जाना:
#     DATABASE_URL=libsql://your-new-database.aws-ap-south-1.turso.io
#     DATABASE_AUTH_TOKEN=your_new_turso_jwt_token
#
#   विकल्प B: लोकल SQLite फ़ाइल (ऑफलाइन / बिना इंटरनेट / लोकल लैपटॉप पर):
#     DATABASE_URL=file:data/rajasthan_police_marathon.db
#     DATABASE_AUTH_TOKEN=
#
#   विकल्प C: राजस्थान पुलिस का अपना डेटा सेंटर / VPS / Docker / Private sqld Server:
#     DATABASE_URL=https://db.police.rajasthan.gov.in
#     DATABASE_AUTH_TOKEN=your_private_datacenter_token
#
# 🔑 किसको देनी है / कब देनी है?
# 🔒 अति-गोपनीय (Top Secret): केवल मुख्य सिस्टम एडमिनिस्ट्रेटर / DevOps इंजीनियर और
# Vercel के Environment Variables में डालें। किसी भी वॉलंटियर, वेंडर या पब्लिक को कभी न दें।
# ------------------------------------------------------------------------------
DATABASE_URL=libsql://rajpol-marathon-mpalsaniya68.aws-ap-south-1.turso.io
DATABASE_AUTH_TOKEN=your_turso_auth_token_here

# बैकवर्ड कम्पैटिबिलिटी हेतु वैकल्पिक (यदि DATABASE_URL न दी गई हो):
TURSO_DATABASE_URL=libsql://rajpol-marathon-mpalsaniya68.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here


# ------------------------------------------------------------------------------
# 2. 🔐 मास्टर क्रिप्टोग्राफिक सुरक्षा कुंजी (MASTER ENCRYPTION & SECURITY SALT)
# ------------------------------------------------------------------------------
# 📌 यह की क्यों है और क्या करती है?
# यह पूरे सिस्टम की मुख्य क्रिप्टोग्राफिक चाबी (HMAC Secret) है। इसका उपयोग:
#   1. एडमिन व वॉलंटीयर्स के 24-घंटे के डिजिटल सेशन टोकन को साइन करने में।
#   2. मोबाइल OTP वेरिफिकेशन टोकन को क्रिप्टोग्राफिकली सील करने में।
#   3. ई-पास और डिजिटल सर्टिफिकेट के एंटी-काउंटरफीट QR कोड जनरेट करने में।
#   4. DPDP Act 2023 के तहत आधार/पैन नंबर को वन-वे हैश (SHA-256 Salted) करने में।
#
# 📥 कहाँ से प्राप्त करें:
# कोई भी मजबूत 32 से 64 कैरेक्टर की रैंडम स्ट्रिंग (उदा. 'node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"').
#
# ⚠️ खाली छोड़ने पर: सिस्टम एक इन-बिल्ट डिफ़ॉल्ट साल्ट लेगा, लेकिन लाइव प्रोडक्शन में कस्टम की डालना अनिवार्य है।
#
# 🔑 किसको देनी है / कब देनी है?
# 🔒 अत्यंत गोपनीय: यह केवल सर्वर बैकएंड में गुप्त रखी जाती है। इसे किसी भी अधिकारी, वॉलंटियर या वेंडर को नहीं दिया जाता।
# ------------------------------------------------------------------------------
APP_SECRET=rajpol_marathon_2027_super_secure_salt_jaipur_command_hq


# ------------------------------------------------------------------------------
# 3. 👮‍♂️ राजस्थान पुलिस मुख्यालय (PHQ) कमांड एवं एक्सपो क्रेडेंशियल्स
# ------------------------------------------------------------------------------
# 📌 यह कीज़ क्यों हैं और क्या करती हैं?
# जब भी नया डेटाबेस इनिशियलाइज़ होता है, सिस्टम इस यूजरनेम और पासवर्ड से PHQ सुपर एडमिन
# अकाउंट स्वतः बना देता है। 
#
#   • ADMIN_BOOTSTRAP_USERNAME : PHQ सुपर एडमिन का लॉगिन यूजरनेम।
#   • ADMIN_BOOTSTRAP_PASSWORD : PHQ सुपर एडमिन का मुख्य पासवर्ड (न्यूनतम 12-16 अक्षर)।
#   • ADMIN_BOOTSTRAP_MOBILE   : अधिकृत नोडल पुलिस अधिकारी का मोबाइल नंबर (2FA OTP इसी पर जाएगा)।
#   • EXPO_PASSCODE            : एक्सपो किट वितरण काउंटर वॉलंटीयर्स का सुरक्षा पिन।
#
# 🔑 किसको देनी है / कब देनी है?
#   • ADMIN क्रेडेंशियल्स: केवल PHQ नोडल अधिकारी (SP/DIG स्तर) को ही दें। पासवर्ड सही होने
#     पर भी अधिकृत मोबाइल पर 2FA OTP आए बिना लॉगिन नहीं हो सकता।
#   • EXPO_PASSCODE: एक्सपो वाले दिन काउंटर वॉलंटीयर्स व गेट इंचार्ज पुलिसकर्मियों को दें
#     ताकि वे टर्मिनल खोलकर धावकों को किट वितरण व QR स्कैन कर सकें।
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_USERNAME=phq_admin
ADMIN_BOOTSTRAP_PASSWORD="RajPol@PHQ#2027"
ADMIN_BOOTSTRAP_MOBILE=7023233248
EXPO_PASSCODE="Expo@RajPol#2027"


# ------------------------------------------------------------------------------
# 4. 🏛️ राजस्थान सरकार आधिकारिक SMS गेटवे (RajSMS - DOIT&C GOVT GATEWAY)
# ------------------------------------------------------------------------------
# 📌 यह कीज़ क्यों हैं और क्या करती हैं?
# धावकों के मोबाइल सत्यापन (OTP), पंजीकरण पुष्टि (Bib #), और मैराथन समापन पर डिजिटल सर्टिफिकेट
# का लिंक SMS द्वारा प्रेषित करने हेतु राजस्थान सरकार के सूचना प्रौद्योगिकी एवं संचार विभाग (DOIT&C)
# के आधिकारिक RajSMS गेटवे का एकीकरण।
#
#   • SMS_PROVIDER             : 'rajsms' (सरकारी RajSMS गेटवे हेतु) या 'nic' / 'msg91'
#   • SMS_GATEWAY_URL          : RajSMS पुश URL (उदा. https://rajsms.rajasthan.gov.in/postpush.do)
#   • SMS_USERNAME             : DOIT&C द्वारा पुलिस विभाग को आवंटित RajSMS सर्विस यूजरनेम
#   • SMS_PASSWORD             : RajSMS सर्विस पासवर्ड
#   • SMS_SENDER_ID            : 6-अक्षरों का TRAI अनुमोदित हेडर (उदा. RAJPOL / RJGOVT)
#   • SMS_DLT_ENTITY_ID        : 14-अंकीय DLT प्रिंसिपल एंटिटी आईडी (Govt of Rajasthan)
#   • SMS_DLT_OTP_TEMPLATE_ID  : OTP प्रेषण हेतु स्वीकृत DLT टेम्पलेट आईडी
#   • SMS_DLT_REG_TEMPLATE_ID  : सफल पंजीकरण SMS हेतु स्वीकृत DLT टेम्पलेट आईडी
#   • SMS_DLT_CERT_TEMPLATE_ID : सर्टिफिकेट डाउनलोड SMS हेतु स्वीकृत DLT टेम्पलेट आईडी
#
# ⚙️ सिमुलेशन मोड (ENABLE_OTP_SIMULATION):
#   • 'true'  : टेस्टिंग/डेवलपमेंट के दौरान स्क्रीन पर ही OTP टोस्ट बैज दिखेगा (बिना SMS के तुरंत टेस्ट)।
#   • 'false' : लाइव मैराथन लॉन्च के समय जब वास्तविक RajSMS से धावकों के फोन पर SMS भेजना हो।
#
# 🔑 किसको देनी है / कब देनी है?
# 🔒 गोपनीय: केवल सर्वर बैकएंड को। RajSMS क्रेडेंशियल्स DOIT&C से प्राप्त कर यहाँ दर्ज करें।
# ------------------------------------------------------------------------------
SMS_PROVIDER=rajsms
SMS_GATEWAY_URL=https://rajsms.rajasthan.gov.in/postpush.do
SMS_USERNAME=rajasthan_police_dept
SMS_PASSWORD=your_rajsms_service_password_here
SMS_SENDER_ID=RAJPOL
SMS_DLT_ENTITY_ID=1101xxxxxxxxxxxxxx
SMS_DLT_OTP_TEMPLATE_ID=1107xxxxxxxxxxxxxx
SMS_DLT_REG_TEMPLATE_ID=1107xxxxxxxxxxxxxx
SMS_DLT_CERT_TEMPLATE_ID=1107xxxxxxxxxxxxxx
ENABLE_OTP_SIMULATION=true


# ------------------------------------------------------------------------------
# 5. ⏱️ RFID टाइमिंग हार्डवेयर सुरक्षा की (RFID TIMING MAT HARDWARE KEY)
# ------------------------------------------------------------------------------
# 📌 यह की क्यों है और क्या करती है?
# मैराथन के दिन दौड़ मार्ग पर स्थापित RFID टाइमिंग मैट्स (Start Line, 5KM, 10KM, और Finish Line)
# से धावकों के चिप रीडर का टाइमिंग डेटा सर्वर पर सुरक्षित रूप से पुश करने हेतु अधिकृत API टोकन।
# जब टाइमिंग मशीनें 'POST /api/tracking/scan' पर 'X-Timing-Key' हेडर भेजती हैं, तभी डेटा स्वीकार होता है।
#
# 🔑 किसको देनी है / कब देनी है?
# ⏱️ सिर्फ आधिकारिक टाइमिंग वेंडर को: मैराथन से 1-2 दिन पहले केवल उस अधिकृत RFID तकनीकी टीम
# को दें जो ग्राउंड पर एंटेना और चिप रीडर लगा रहे हैं, ताकि उनकी मशीनें टाइमिंग पंच कर सकें।
# ❌ किसी अन्य व्यक्ति या वॉलंटीयर को न दें ताकि कोई फर्जी फिनिश टाइमिंग न डाल सके।
# ------------------------------------------------------------------------------
TIMING_API_KEY=rajpol_timing_mat_hardware_key_2027


# ------------------------------------------------------------------------------
# 6. 💳 ऑनलाइन पेमेंट गेटवे विन्यास (ONLINE PAYMENT GATEWAY CONFIGURATION)
# ------------------------------------------------------------------------------
# 📌 यह कीज़ क्यों हैं और क्या करती हैं?
# धावकों से ऑनलाइन रजिस्ट्रेशन शुल्क (21KM/10KM/5KM) प्राप्त करने हेतु पेमेंट गेटवे।
#
#   • PAYMENT_GATEWAY_PROVIDER : 'razorpay' | 'payu' | 'sbi_epay' | 'billdesk'
#   • PAYMENT_KEY_ID           : मर्चेंट पब्लिक Key ID (उदा. rzp_live_xxxxxxxx)
#   • PAYMENT_KEY_SECRET       : मर्चेंट प्राइवेट सीक्रेट Key (वेरिफिकेशन सिग्नेचर हेतु)
#
# ⚠️ खाली छोड़ने पर: सिस्टम सिमुलेशन मोड में चलेगा (बिना वास्तविक पैसों के UPI QR स्कैन डेमो होगा)।
#
# 🔑 किसको देनी है / कब देनी है?
#   • PAYMENT_KEY_ID     : पब्लिक है, फ्रंटेंड व बैकएंड दोनों में जा सकती है।
#   • PAYMENT_KEY_SECRET : 🔒 अति-गोपनीय: सिर्फ सर्वर बैकएंड को दें, किसी थर्ड-पार्टी को कभी न दें।
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
