# -------------------------------------------------------------
# 🏛️ RAJASTHAN POLICE MARATHON 2027 - ENVIRONMENT TEMPLATE
# Copy this file to .env and provide your production credentials
# -------------------------------------------------------------

# 1. DATABASE CONFIGURATION (Turso Cloud Edge DB)
# Leave empty to fallback to local SQLite (data/rajasthan_police_marathon.db)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 2. MASTER SECURITY KEY (APP_SECRET)
# High-entropy cryptographic secret for signing Admin Tokens, OTP tokens, and DPDP Act hashing
APP_SECRET=your_super_secret_64_character_random_salt_jaipur

# 3. PAYMENT GATEWAY (Optional: Leave empty for simulated mode, or fill for live payments)
# Supported Providers: razorpay | payu | sbi_epay | billdesk
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_KEY_ID=rzp_live_xxxxxxxxxxxxxx
PAYMENT_KEY_SECRET=your_razorpay_secret_here

# 4. OFFICIAL RAJASTHAN GOVT SMS GATEWAY (RajSMS - DOIT&C / NIC / Commercial)
# Leave empty for automatic local simulation, or configure for live SMS delivery
SMS_PROVIDER=rajsms
SMS_GATEWAY_URL=https://rajsms.rajasthan.gov.in/postpush.do
SMS_USERNAME=rajasthan_police_dept
SMS_PASSWORD=your_rajsms_service_password_here
SMS_API_KEY=your_rajsms_token_or_api_key
SMS_SENDER_ID=RAJPOL
SMS_DLT_ENTITY_ID=1101xxxxxxxxxxxxxx
SMS_DLT_OTP_TEMPLATE_ID=1107xxxxxxxxxxxxxx
SMS_DLT_REG_TEMPLATE_ID=1107xxxxxxxxxxxxxx
SMS_DLT_CERT_TEMPLATE_ID=1107xxxxxxxxxxxxxx

# 5. RFID HARDWARE TIMING MAT API KEY
# Secret token for Start / 5KM / 10KM / Finish Line RFID timing readers
TIMING_API_KEY=rajpol_timing_mat_hardware_key_2027
